+router.patch('/save', function (request, response) {
+    // Same origin/authentication, CSRF, body decompression, atomic writer, and backup owner as full saves.
+    // Synchronous read/check/write in the single Tavern writer: no races between comparison and commit.
+    if (request.get('X-ST-Settings-Wire') === 'delta-v1') {
+        try {
+            const file = path.join(request.user.directories.root, SETTINGS_FILE);
+            const state = applyDelta(JSON.parse(fs.readFileSync(file, 'utf8')), request.body);
+            if (state.changed) {
+                writeFileAtomicSync(file, JSON.stringify(state.data, null, 4), 'utf8');
+                versionedWriters.add(request.user.profile.handle);
+                triggerAutoSave(request.user.profile.handle);
+            }
+            return response.set('Cache-Control','no-store').send({ result:'ok', wire:1, ...(request.get('X-ST-Settings-Revision')==='yes'
+                    ? {revision:settingsHash('sha256').update(JSON.stringify(state.data)).digest('hex')} : {}) });
+        } catch (e) {
+            const status = [400,409].includes(e.status) ? e.status : 500;
+            return response.status(status).send({error:status===409?'settings_conflict':'settings_delta_failed'});
+        }
+    }
+    return response.sendStatus(400);
+});
 
