+router.get('/wire-part/:id', (request,response) => {
+    const id=request.params.id;
+    if(!/^[a-f0-9]{64}$/.test(id))return response.sendStatus(404);
+    const part=lookup(request.user.profile.handle,id);
+    if(!part)return response.set('Cache-Control','no-store').sendStatus(410);
+    // The original document is NEVER stored in the HTTP cache; only the client
+    // can persist the sealed version. Let the browser's HTTP stack decode Brotli.
+    response.set('Cache-Control','private, no-store').set('X-ST-Settings-Part',id).vary('Accept-Encoding');
+    if(request.acceptsEncodings('br')==='br')return response.set('Content-Encoding','br').type('application/json').send(part);
+    return response.type('application/json').send(decompressSettingsPart(part));
+});
